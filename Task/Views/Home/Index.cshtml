<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">
  <h2>Контакты</h2>
  <button class="btn btn-primary mb-3" onclick="openCreate()">Добавить контакт</button>
  <ul id="list" class="list-group"></ul>
</div>

<div class="modal fade" id="modal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 id="title">Новый контакт</h5>
      </div>
      <div class="modal-body">
        <input id="name" class="form-control mb-2" placeholder="Имя">
        <input id="phone" class="form-control mb-2" placeholder="Телефон XXX XX XXX XX XX">
        <input id="job" class="form-control mb-2" placeholder="Должность">
        <input id="birth" class="form-control mb-2" type="date">
        <div id="error" class="text-danger small"></div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
        <button class="btn btn-success" onclick="save()">Сохранить</button>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
let editingId = null;
const modal = new bootstrap.Modal(document.getElementById('modal'));

const list = document.getElementById('list');
const name = document.getElementById('name');
const phone = document.getElementById('phone');
const job = document.getElementById('job');
const birth = document.getElementById('birth');
const error = document.getElementById('error');
const title = document.getElementById('title');

load();

function load() {
  fetch('/Contacts')
    .then(r => r.json())
    .then(data => {
      list.innerHTML = '';
      data.forEach(c => {
        list.innerHTML += `
          <li class="list-group-item d-flex justify-content-between">
            <div>
              <b>${c.name}</b><br>
              <small>${c.jobTitle}</small><br>
              <small>${c.mobilePhone} · ${c.birthDate.substring(0,10)}</small>
            </div>
            <div>
                <button class="btn btn-sm btn-warning me-1" onclick='edit(${JSON.stringify(c)})'>Изм</button>
                <button class="btn btn-sm btn-danger" onclick="removeContact(${c.id})">X</button>
            </div>
          </li>`;
      });
    });
}

function openCreate() {
  editingId = null;
  title.innerText = 'Новый контакт';
  name.value = phone.value = job.value = birth.value = '';
  error.innerText = '';
  modal.show();
}

function edit(c) {
  editingId = c.id;
  title.innerText = 'Редактировать';
  name.value = c.name;
  phone.value = c.mobilePhone;
  job.value = c.jobTitle;
  birth.value = c.birthDate.substring(0,10);
  error.innerText = '';
  modal.show();
}


function save() {
  if (!name.value.trim()) {
    error.innerText = 'Имя обязательно';
    return;
  }
  if (!birth.value) {
    error.innerText = 'Дата рождения обязательна';
    return;
  }
  
  const birthDate = new Date(birth.value);
  const today = new Date();
  
  if (birthDate > today) {
    error.innerText = 'Дата рождения не может быть в будущем';
    return;
  }
    const oldest = new Date();
  oldest.setFullYear(today.getFullYear() - 60);
  if (birthDate < oldest) {
    error.innerText = 'Дата рождения слишком старая';
    return;
  }
  if(!job.value.trim())
  {
    error.innerText = 'Должность не должна быть пустой';
    return;
  }
  const phonePattern = /^\+?\d{10,13}$/;
  if (phone.value && !phonePattern.test(phone.value.trim())) {
  error.innerText = 'Неверный формат телефона';
  return;
  }

  const body = {
    Id: editingId ?? 0,
    Name: name.value,
    MobilePhone: phone.value,
    JobTitle: job.value,
    BirthDate: birth.value
  };

  fetch(editingId ? '/Contacts/Update' : '/Contacts/Create', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body)
  })
  .then(r => {
    if (!r.ok) throw new Error();
    modal.hide();
    load();
  })
  .catch(() => error.innerText = 'Ошибка сохранения');
}

function removeContact(id) {
  if (!confirm('Удалить контакт?')) return;
  fetch('/Contacts/Delete?id=' + id, { method: 'DELETE' })
    .then(load);
}
</script>
